{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moduvera:schema:message:structured-event-envelope:1",
  "title": "Moduvera structured CloudEvent envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "specversion", "id", "source", "type", "destination", "time",
    "datacontenttype", "dataschema", "tenantid", "actortype", "actorsubject",
    "correlationid", "initiatortype", "initiatorsubject",
    "partitionkey", "data"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": { "type": "string", "format": "uri" },
    "type": { "type": "string", "pattern": "\\.v[1-9][0-9]*$" },
    "destination": { "type": "string", "minLength": 1, "maxLength": 256 },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "type": "string", "minLength": 1 },
    "dataschema": { "type": "string", "format": "uri" },
    "tenantid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actortype": { "enum": ["USER", "SERVICE", "SYSTEM"] },
    "actorsubject": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlationid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "initiatortype": { "enum": ["USER", "SERVICE", "SYSTEM"] },
    "initiatorsubject": { "type": "string", "minLength": 1, "maxLength": 128 },
    "partitionkey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "data": true
  }
}
