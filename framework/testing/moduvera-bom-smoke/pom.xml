<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath />
  </parent>

  <groupId>io.github.ande1922.moduvera</groupId>
  <artifactId>moduvera-bom-smoke</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Moduvera :: Testing :: BOM Consumer Smoke</name>

  <properties>
    <java.version>26</java.version>
    <moduvera.version>0.1.0-SNAPSHOT</moduvera.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.ande1922.moduvera</groupId>
        <artifactId>moduvera-bom</artifactId>
        <version>${moduvera.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-database-migration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-lock-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-lock-local</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-message-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-auth-resource-server-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-data-mybatis-plus-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-database-migration-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-messaging-kafka-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-scheduler-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-test-support</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-architecture-testkit</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>moduvera-web-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>catalog-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>catalog-service</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>inventory-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>inventory-service</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>order-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.ande1922.moduvera</groupId>
      <artifactId>order-service</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <directory>${project.build.directory}/generated-test-resources/bom-smoke</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-help-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>generate-consumer-effective-pom</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>effective-pom</goal>
            </goals>
            <configuration>
              <output>${project.build.directory}/generated-test-resources/bom-smoke/moduvera-bom-effective-pom.xml</output>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
