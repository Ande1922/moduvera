<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ande1922.moduvera</groupId>
  <artifactId>moduvera-reactor</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Moduvera :: Reactor</name>
  <description>Repository reactor for the Moduvera framework and reference product</description>

  <modules>
    <module>framework/bom</module>
    <module>framework/parent</module>
    <module>framework/foundation/moduvera-kernel</module>
    <module>framework/foundation/moduvera-lock-core</module>
    <module>framework/foundation/moduvera-object-storage-api</module>
    <module>framework/foundation/moduvera-message-core</module>
    <module>framework/foundation/moduvera-database-migration</module>
    <module>framework/starters/moduvera-auth-resource-server-autoconfigure</module>
    <module>framework/starters/moduvera-data-mybatis-plus-spring-boot-starter</module>
    <module>framework/starters/moduvera-messaging-kafka-spring-boot-starter</module>
    <module>framework/starters/moduvera-scheduler-spring-boot-starter</module>
    <module>framework/testing/moduvera-test-support</module>
    <module>framework/testing/moduvera-bom-smoke</module>
    <module>framework/adapters/moduvera-lock-local</module>
    <module>framework/starters/moduvera-web-spring-boot-starter</module>
    <module>services/catalog/catalog-api</module>
    <module>services/inventory/inventory-api</module>
    <module>services/order/order-api</module>
    <module>services/catalog/catalog-service</module>
    <module>services/inventory/inventory-service</module>
    <module>services/order/order-service</module>
    <module>framework/testing/moduvera-architecture-testkit</module>
    <module>apps/catalog-app</module>
    <module>apps/order-app</module>
    <module>apps/inventory-app</module>
    <module>apps/identity-app</module>
    <module>apps/gateway-app</module>
    <module>apps/app-monolith</module>
    <module>examples/simple-notes-demo</module>
  </modules>

  <properties>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-maven-plugin.version}</version>
        <inherited>false</inherited>
        <configuration>
          <outputFormat>json</outputFormat>
          <schemaVersion>1.6</schemaVersion>
        </configuration>
        <executions>
          <execution>
            <id>make-aggregate-sbom</id>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
